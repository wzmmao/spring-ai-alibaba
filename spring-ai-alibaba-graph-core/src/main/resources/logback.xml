<?xml version="1.0" encoding="UTF-8"?>
<configuration >
    <!--指定项目名-->
    <property name="PROJECT_NAME" value="PROJECT_NAME_UN_DEFINED" />
    <property name="MODULE_NAME" value="MODULE_NAME_UN_DEFINED" />
    <property name="LOG_PATH" value="/Users/milo/mySpace/log-milo-project" />
    <property name="log.dir" value="${LOG_PATH}/${PROJECT_NAME}/${MODULE_NAME}" />


    <!--指定某类日志级别-->
    <logger name="org.springframework" level="info"/>


    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</Pattern>
        </encoder>
    </appender>

    <appender name="serverAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.dir}/server.log</file>
        <append>true</append>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <FileNamePattern>${log.dir}/server.%d{yyyy-MM-dd}.log</FileNamePattern>
            <maxHistory>1000</maxHistory>
        </rollingPolicy>
    </appender>
    <appender name="asyncServerAppender" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <queueSize>10000</queueSize>
        <appender-ref ref="serverAppender"/>
    </appender>


    <!--logger级别：TRACE < DEBUG < INFO < WARN < ERROR-->
    <root level="DEBUG">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="asyncServerAppender"/>
    </root>
</configuration>